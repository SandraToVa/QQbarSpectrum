{
    // LaTeX Workshop: build main.tex with latexmk (pdflatex + biber + reruns until references are resolved)
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf", "-outdir=%OUTDIR%", "%DOC%"],
            "env": { "PATH": "/Library/TeX/texbin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin" }
        }
    ],
    "latex-workshop.latex.recipes": [
        { "name": "latexmk (pdflatex + biber)", "tools": ["latexmk"] }
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    // If a build fails, delete the auxiliary files (.aux, .bbl, .bcf, ...) so a broken one cannot block the next build
    "latex-workshop.latex.autoClean.run": "onFailed",
    "latex-workshop.latex.clean.fileTypes": ["*.aux", "*.bbl", "*.bbl-SAVE-ERROR", "*.bcf", "*.bcf-SAVE-ERROR", "*.blg", "*.fdb_latexmk", "*.fls", "*.log", "*.out", "*.run.xml", "*.synctex.gz", "*.toc"],
    "latex-workshop.view.pdf.viewer": "tab"
}
